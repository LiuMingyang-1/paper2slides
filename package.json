{
  "name": "paper2slides",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prompts": "node scripts/compile-prompts.mjs",
    "dev:web": "npm run prompts && vite",
    "build": "npm run prompts && tsc --noEmit && vite build",
    "test": "npm run prompts && vitest run --passWithNoTests",
    "typecheck": "npm run prompts && tsc --noEmit",
    "validate": "npm run build && anna-app validate",
    "dev": "npm run build && anna-app dev"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
